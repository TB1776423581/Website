---
import {
  applicationById,
  categories,
  companyById,
  formatDate,
  tagTechnologies,
  technologyById,
} from "../data/catalog.js";
import { sitePath } from "../lib/url.js";

const { item } = Astro.props;
const company = companyById(item.companyId);
const technologies = tagTechnologies(item);
---
<article class="entry">
  <div class="entry-meta">
    <time class="date" datetime={item.date ?? undefined}>{formatDate(item.date)}</time>
    <div>{categories[item.category]} · {company.region}</div>
  </div>
  <div>
    <a class="company-link" href={sitePath(`/companies/${company.id}`)}>{company.name}</a>
    <h3>
      <a href={sitePath(`/products/${item.id}${item.anchor ? `#${item.anchor}` : ""}`)}>
        {item.title}
      </a>
    </h3>
    <p class="summary">{item.summary}</p>
    <div class="tags">
      {
        item.applications.map((id) => {
          const application = applicationById(id);
          return (
            <a class="tag" href={sitePath(`/applications/${application.id}`)}>
              {application.name}
            </a>
          );
        })
      }
      {
        technologies.map((id) => {
          const technology = technologyById(id);
          return (
            <a class="tag" href={sitePath(`/technologies/${technology.id}`)}>
              {technology.name}
            </a>
          );
        })
      }
    </div>
  </div>
</article>
