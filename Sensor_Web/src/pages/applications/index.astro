---
import Base from "../../layouts/Base.astro";
import { applications, developmentsForApplication } from "../../data/catalog.js";
import { sitePath } from "../../lib/url.js";
---
<Base title="应用" current="applications">
  <div class="page-intro">
    <p class="kicker">应用</p>
    <h1>按使用场景看</h1>
    <p class="lede">同一颗传感器只归到它产品页上写明的主要场景。</p>
  </div>
  <div class="directory">
    {
      applications.map((application) => (
        <a class="row" href={sitePath(`/applications/${application.id}`)}>
          <div>
            <h3>{application.name}</h3>
            <p>{application.description}</p>
          </div>
          <p></p>
          <p class="count">{developmentsForApplication(application.id).length} 个产品</p>
        </a>
      ))
    }
  </div>
</Base>
