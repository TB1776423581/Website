---
import Base from "../../layouts/Base.astro";
import {
  applicationById,
  companyById,
  formatDate,
  modelAnchor,
  products,
  tagTechnologies,
  technologyById,
} from "../../data/catalog.js";
import { sitePath } from "../../lib/url.js";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const company = companyById(product.companyId);
const several = product.models.length > 1;
const technologies = tagTechnologies(product);
---
<Base title={product.title} current="product">
  <div class="page-intro">
    <p class="kicker"><a href={sitePath(`/companies/${company.id}`)}>{company.name}</a></p>
    <h1>{product.title}</h1>
    {
      !several && (
        <time class="date" datetime={product.date}>
          {formatDate(product.date)}
        </time>
      )
    }
    <p class="lede">{product.summary}</p>
    <div class="tags">
      {
        product.applications.map((id) => {
          const application = applicationById(id);
          return (
            <a class="tag" href={sitePath(`/applications/${application.id}`)}>
              {application.name}
            </a>
          );
        })
      }
      {
        technologies.map((id) => {
          const technology = technologyById(id);
          return (
            <a class="tag" href={sitePath(`/technologies/${technology.id}`)}>
              {technology.name}
            </a>
          );
        })
      }
    </div>
  </div>
  {
    several ? (
      <section class="compare">
        <h2>型号对照</h2>
        {product.models.map((model) => (
          <article class="model" id={modelAnchor(model.name)}>
            <div class="model-head">
              <h3>{model.name}</h3>
              <time datetime={model.date}>{formatDate(model.date)}</time>
            </div>
            <ul>
              {model.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </article>
        ))}
      </section>
    ) : (
      <ul class="spec-list" id={modelAnchor(product.models[0].name)}>
        {product.models[0].points.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    )
  }
  <div class="source-links">
    {
      product.models.map((model) => (
        <a class="product-link" href={model.url} target="_blank" rel="noopener noreferrer">
          <span class="product-name">{model.name}</span>
          <span class="product-action">{model.linkLabel}</span>
        </a>
      ))
    }
  </div>
</Base>
