---
import Base from "../layouts/Base.astro";
import { sitePath } from "../lib/url.js";
import { broadbandModels } from "../lib/roadmap.js";
import {
  applications,
  categories,
  companies,
  modelAnchor,
  products,
  technologies,
} from "../data/catalog.js";

function depthKind(product, model) {
  const match = (text) => {
    if (/直接飞行时间|dToF|dTOF/i.test(text)) return "dtof";
    if (/间接飞行时间|iToF|iTOF/i.test(text)) return "itof";
    if (/双目/.test(text)) return "stereo";
    if (/结构光/.test(text)) return "structured";
    return "";
  };
  return match((model.points || []).join("\n")) || match(`${product.title}\n${product.summary}`);
}

function hrefFor(product, model) {
  return sitePath(`/products/${product.id}#${modelAnchor(model.name)}`);
}

function yearOf(date) {
  const match = String(date || "").match(/^(\d{4})/);
  return match ? match[1] : "";
}

const byName = (a, b) => a.localeCompare(b, "zh");

function companyOf(product) {
  return companies.find((company) => company.id === product.companyId)?.name || "未标明公司";
}

function byCompany(items) {
  const groups = new Map();
  for (const item of items) {
    const name = companyOf(item.product);
    if (!groups.has(name)) groups.set(name, []);
    groups.get(name).push(item);
  }
  return [...groups.entries()]
    .sort((a, b) => byName(a[0], b[0]))
    .map(([name, models]) => ({
      name,
      models: models.sort((a, b) => byName(a.model.name, b.model.name)),
    }));
}

function seriesByCompany(series) {
  const groups = new Map();
  for (const product of series) {
    const name = companyOf(product);
    if (!groups.has(name)) groups.set(name, []);
    groups.get(name).push(
      ...product.models.map((model) => ({ product, model })),
    );
  }
  return [...groups.entries()]
    .sort((a, b) => byName(a[0], b[0]))
    .map(([name, models]) => ({
      name,
      models: models.sort((a, b) => byName(a.model.name, b.model.name)),
    }));
}

const applicationLabels = {
  depth: "3D测量",
  machine: "机器视觉",
  auto: "车载",
  mobile: "手机/端侧",
  spectral: "光谱探测",
  scientific: "医疗与科学",
  consumer: "消费电子",
};

const applicationOrder = ["machine", "auto", "mobile", "scientific", "consumer"];

const depthSubtypes = [
  { id: "itof", name: "iTOF" },
  { id: "dtof", name: "dTOF" },
  { id: "stereo", name: "双目视觉" },
  { id: "structured", name: "结构光" },
];

function spectralBand(product, model) {
  if (model.band) return model.band;
  const text = `${product.title}\n${product.summary}\n${(model.points || []).join("\n")}`;
  if (/短波红外|\bSWIR\b/i.test(text)) return "swir";
  return "";
}

const spectralOrder = [
  { id: "uv", name: "紫外" },
  { id: "nir", name: "近红外" },
  { id: "swir", name: "短波" },
  { id: "mwir", name: "中波" },
  { id: "lwir", name: "长波" },
];

const technologyLabels = {
  tof: "飞行时间",
  spectral: "光谱探测",
};

const depthModels = products
  .flatMap((product) =>
    product.models
      .filter((model) => (model.technologies ?? product.technologies).includes("tof"))
      .map((model) => ({
        product,
        model,
        kind: depthKind(product, model),
      })),
  )
  .sort((a, b) => byName(a.model.name, b.model.name));

const spectralModels = products
  .filter((product) => product.applications.includes("spectral"))
  .flatMap((product) =>
    product.models.map((model) => ({
      product,
      model,
      band: spectralBand(product, model),
    })),
  )
  .sort((a, b) => byName(a.model.name, b.model.name));

const broadbandCompanies = byCompany(broadbandModels());

const spectralBands = spectralOrder
  .map((band) => ({
    ...band,
    companies: byCompany(spectralModels.filter((item) => item.band === band.id)),
  }))
  .filter((band) => band.companies.length);

const applicationBranches = applicationOrder
  .map((id) => applications.find((item) => item.id === id))
  .filter(Boolean)
  .map((application) => {
    const series = products
      .filter((product) => product.applications.includes(application.id))
      .sort((a, b) => byName(a.title, b.title));
    return {
      id: application.id,
      label: applicationLabels[application.id] || application.name,
      series,
      companies: seriesByCompany(series),
    };
  })
  .filter((branch) => branch.series.length);

const regionBranches = [
  { id: "国内", label: "国内" },
  { id: "国外", label: "国外" },
].map((region) => ({
  ...region,
  companies: companies
    .filter((company) => (region.id === "国内" ? company.region === "国内" : company.region !== "国内"))
    .map((company) => ({
      company,
      series: products
        .filter((product) => product.companyId === company.id)
        .sort((a, b) => byName(a.title, b.title)),
    }))
    .filter((item) => item.series.length)
    .sort((a, b) => byName(a.company.name, b.company.name)),
})).filter((region) => region.companies.length);

const tofBranch = {
  subtypes: depthSubtypes
    .map((subtype) => ({
      ...subtype,
      companies: byCompany(depthModels.filter((item) => item.kind === subtype.id)),
    }))
    .filter((subtype) => subtype.companies.length),
  rest: byCompany(depthModels.filter((item) => !item.kind)),
};

const technologyBranches = technologies
  .map((technology) => {
    const models = products
      .flatMap((product) =>
        product.models
          .filter((model) => (model.technologies ?? product.technologies).includes(technology.id))
          .map((model) => ({ product, model })),
      )
      .sort((a, b) => byName(a.model.name, b.model.name));
    return {
      id: technology.id,
      label: technologyLabels[technology.id] || technology.name,
      companies: byCompany(models),
    };
  })
  .filter((branch) => branch.id === "tof" || branch.id === "spectral" || branch.companies.length);

const trendBranches = Object.entries(categories)
  .map(([id, label]) => {
    const rows = products
      .filter((product) => product.category === id)
      .flatMap((product) =>
        product.models.map((model) => ({
          product,
          model,
          date: model.date || product.date || "",
        })),
      );
    const years = [...new Set(rows.map((row) => yearOf(row.date)))].sort((a, b) => {
      if (!a) return 1;
      if (!b) return -1;
      return b.localeCompare(a);
    });
    return {
      label,
      years: years.map((year) => ({
        label: year || "未写年份",
        models: rows
          .filter((row) => yearOf(row.date) === year)
          .sort((a, b) => (b.date || "").localeCompare(a.date || "") || byName(a.model.name, b.model.name)),
      })),
    };
  })
  .filter((branch) => branch.years.some((year) => year.models.length));
---
<Base current="home">
  <div class="index-tree">
    <details class="tree-trunk" open>
      <summary>FDWH_Sensor_Collect</summary>
      <div class="tree-children">
        <details>
          <summary>技术</summary>
          <div class="tree-children">
            {
              technologyBranches.map((branch) =>
                branch.id === "tof" ? (
                  <details>
                    <summary>{branch.label}</summary>
                    <div class="tree-children">
                      {tofBranch.subtypes.map((subtype) => (
                        <div class="tree-label">
                          <details>
                            <summary>{subtype.name}</summary>
                            <div class="tree-children">
                              {subtype.companies.map((company) => (
                                <details>
                                  <summary>{company.name}</summary>
                                  <ul class="leaves">
                                    {company.models.map((item) => (
                                      <li>
                                        <a href={hrefFor(item.product, item.model)}>{item.model.name}</a>
                                      </li>
                                    ))}
                                  </ul>
                                </details>
                              ))}
                            </div>
                          </details>
                          <a class="roadmap-link" href={sitePath(`/roadmap/${subtype.id}`)}>路线图</a>
                        </div>
                      ))}
                      {tofBranch.rest.length > 0 && (
                        <details>
                          <summary>其他</summary>
                          <div class="tree-children">
                            {tofBranch.rest.map((company) => (
                              <details>
                                <summary>{company.name}</summary>
                                <ul class="leaves">
                                  {company.models.map((item) => (
                                    <li>
                                      <a href={hrefFor(item.product, item.model)}>{item.model.name}</a>
                                    </li>
                                  ))}
                                </ul>
                              </details>
                            ))}
                          </div>
                        </details>
                      )}
                    </div>
                  </details>
                ) : branch.id === "spectral" ? (
                  <details>
                    <summary>{branch.label}</summary>
                    <div class="tree-children">
                      {spectralBands.map((band) => (
                        <div class="tree-label">
                          <details>
                            <summary>{band.name}</summary>
                            <div class="tree-children">
                              {band.companies.map((company) => (
                                <details>
                                  <summary>{company.name}</summary>
                                  <ul class="leaves">
                                    {company.models.map((item) => (
                                      <li>
                                        <a href={hrefFor(item.product, item.model)}>{item.model.name}</a>
                                      </li>
                                    ))}
                                  </ul>
                                </details>
                              ))}
                            </div>
                          </details>
                          <a class="roadmap-link" href={sitePath(`/roadmap/${band.id}`)}>路线图</a>
                        </div>
                      ))}
                      {broadbandCompanies.length > 0 && (
                        <div class="tree-label">
                          <details>
                            <summary>通谱</summary>
                            <div class="tree-children">
                              {broadbandCompanies.map((company) => (
                                <details>
                                  <summary>{company.name}</summary>
                                  <ul class="leaves">
                                    {company.models.map((item) => (
                                      <li>
                                        <a href={hrefFor(item.product, item.model)}>{item.model.name}</a>
                                      </li>
                                    ))}
                                  </ul>
                                </details>
                              ))}
                            </div>
                          </details>
                          <a class="roadmap-link" href={sitePath("/roadmap/broadband")}>路线图</a>
                        </div>
                      )}
                    </div>
                  </details>
                ) : (
                  <details>
                    <summary>{branch.label}</summary>
                    <div class="tree-children">
                      {branch.companies.map((company) => (
                        <details>
                          <summary>{company.name}</summary>
                          <ul class="leaves">
                            {company.models.map((item) => (
                              <li>
                                <a href={hrefFor(item.product, item.model)}>{item.model.name}</a>
                              </li>
                            ))}
                          </ul>
                        </details>
                      ))}
                    </div>
                  </details>
                ),
              )
            }
          </div>
        </details>

        <details>
          <summary>应用</summary>
          <div class="tree-children">
            {
              applicationBranches.map((branch) => (
                <details>
                  <summary>{branch.label}</summary>
                  <div class="tree-children">
                    {branch.companies.map((company) => (
                      <details>
                        <summary>{company.name}</summary>
                        <ul class="leaves">
                          {company.models.map((item) => (
                            <li>
                              <a href={hrefFor(item.product, item.model)}>{item.model.name}</a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    ))}
                  </div>
                </details>
              ))
            }
          </div>
        </details>

        <details>
          <summary>公司</summary>
          <div class="tree-children">
            {
              regionBranches.map((region) => (
                <details>
                  <summary>{region.label}</summary>
                  <div class="tree-children">
                    {region.companies.map((item) => (
                      <details>
                        <summary>{item.company.name}</summary>
                        <div class="tree-children">
                          {item.series.map((product) => (
                            <details>
                              <summary>{product.title}</summary>
                              <ul class="leaves">
                                {product.models.map((model) => (
                                  <li>
                                    <a href={hrefFor(product, model)}>{model.name}</a>
                                  </li>
                                ))}
                              </ul>
                            </details>
                          ))}
                        </div>
                      </details>
                    ))}
                  </div>
                </details>
              ))
            }
          </div>
        </details>

        <details>
          <summary>动向</summary>
          <div class="tree-children">
            {
              trendBranches.map((branch) => (
                <details>
                  <summary>{branch.label}</summary>
                  <div class="tree-children">
                    {branch.years.map((year) => (
                      <details>
                        <summary>{year.label}</summary>
                        <ul class="leaves">
                          {year.models.map((item) => (
                            <li>
                              <a href={hrefFor(item.product, item.model)}>{item.model.name}</a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    ))}
                  </div>
                </details>
              ))
            }
          </div>
        </details>
      </div>
    </details>
  </div>
</Base>
